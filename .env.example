# ─────────────────────────────────────────────────────────────
# Variables d'environnement — TGT Propreté
# Sur Vercel : Project → Settings → Environment Variables
# En local : copie ce fichier en ".env.local" et remplis les valeurs
# ─────────────────────────────────────────────────────────────

# ✅ REQUISE — URL canonique du site en production (sans slash final).
# Utilisée par le SEO : metadata, sitemap.xml, robots.txt, images Open Graph.
# Mets ton vrai nom de domaine ici une fois branché sur Vercel.
NEXT_PUBLIC_SITE_URL=https://ton-domaine.fr

# ─────────────── Optionnel — Avis Google en direct ───────────────
# Si absentes, le site affiche des témoignages de secours (déjà en place).
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
# NEXT_PUBLIC_GOOGLE_PLACE_ID=

# ─────────────── Optionnel — Envoi des emails (non branché) ───────────────
# Le formulaire de candidature/devis valide et enregistre, mais l'envoi email
# reste à brancher (placeholder Resend dans app/api/*/route.ts).
# RESEND_API_KEY=
# CANDIDATURE_INBOX_EMAIL=Tgtproprete@gmail.com
# DEVIS_INBOX_EMAIL=Tgtproprete@gmail.com
