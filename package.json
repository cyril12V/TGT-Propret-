{
  "name": "tgt-proprete",
  "version": "0.1.0",
  "private": true,
  "description": "Site officiel TGT Propreté — entretien et nettoyage professionnel en Île-de-France",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
